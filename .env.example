# Django настройки
SECRET_KEY=django-insecure-3x8^&%jf#$%^&*(*&^%$#@!~qwertyuiop123456789
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL настройки
DB_ENGINE=django.db.backends.postgresql
DB_NAME=habbit_tracker
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_HOST=localhost
DB_PORT=5432

# Redis настройки
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Celery настройки
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Telegram бот настройки
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Опционально: ID чата для тестирования
# Можно получить написав боту @userinfobot
TELEGRAM_TEST_CHAT_ID=your_test_chat_id_here